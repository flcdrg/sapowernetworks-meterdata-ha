#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

case "${1:-default}" in
    default)
        uv run --locked pytest -q
        ;;
    min-ha)
        HA_VERSION="$(python3 - <<'PY'
import json
from pathlib import Path

print(json.loads(Path("hacs.json").read_text())["homeassistant"])
PY
        )"
        uv run --isolated --no-project \
            --with-requirements tests/requirements-min-ha.txt \
            --with "homeassistant==${HA_VERSION}" pytest -q
        ;;
    *)
        echo "Usage: scripts/test [default|min-ha]" >&2
        exit 2
        ;;
esac
